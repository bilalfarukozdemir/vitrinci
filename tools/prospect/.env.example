# Google Cloud API anahtari.
# Aktif etmen gereken 2 API: "Places API (New)" ve "PageSpeed Insights API"
# console.cloud.google.com > APIs & Services > Enable APIs
#
# Maliyet: Text Search Enterprise+Atmosphere SKU, aylik 1.000 istek ucretsiz,
# sonrasi ~$40/1000. Kota tavani koymayi unutma (bkz. README).
GOOGLE_API_KEY=

# Raporlarin altindaki iletisim bloguna basilacak bilgiler.
SAHIP_ADI=<adin>
SAHIP_UNVAN=Web & SEO
SAHIP_TELEFON=+90 5xx xxx xx xx
SAHIP_EPOSTA=ornek@ornek.example
SAHIP_SITE=senin-alan-adin.com

# Rapordaki sosyal kanit satiri.
#
# IKI TUR IDDIA VAR, KARISTIRMA:
#
#   SIRA iddiasi   — BUGUN kullanilabilir. Google'da kelimeyi aratip goruyorsun,
#                    karsi taraf da aratip dogrulayabiliyor. Gecmis veri gerekmiyor.
#                    Ornek: '"duzce kilit tasi" aramasinda ilk sirada cikiyor'
#
#   TRAFIK iddiasi — Search Console GECMISI gerektiriyor. Veri ~2 gun gecikmeyle
#                    geliyor; anlamli bir aylik rakam icin en az 28 gun, oturmus
#                    ortalama icin 3 ay lazim.
#                    Birkac gunluk veriyle cikan rakam ("aylik 40 gosterim")
#                    hic yazmamaktan KOTU — seni kucuk gosteriyor.
#
# Once sira iddiasiyla basla. 4 hafta sonra Search Console'a bakip trafigi ekle.
#
# Asagidaki iki satir DOLDURULACAK YER TUTUCU. Kendi isinle degistir —
# olmayan bir referansi yazmak, ilk kontrolde is birlikte bitiyor.
REFERANS_METNI=<Sehir>'de <Firma>'nin sitesini yaptim; "<aranan kelime>" 1., "<aranan kelime>" 3. sirada.
REFERANS_LINK=https://senin-referansin.com

# ─────────────────────────────────────────────────────────────────────
# DEMO YAYIN AYARLARI
#
# Demolarin yayinlandigi alan adi. Bos birakilirsa demo sayfalari
# `demo.local` varsayiyor ve panel localhost'a link veriyor.
DEMO_ALAN=

# Demo sayfasinin dibindeki "Tasarim ve yapim" kaydi.
# IKISI DE BOSSA blok hic basilmiyor — yeni kurulumun sayfasi kimsenin
# reklamini yapmiyor. Kendi adini yazdiginda beliriyor.
YAPIMCI_AD=
YAPIMCI_URL=
